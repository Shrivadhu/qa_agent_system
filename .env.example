# ==============================================================================
# QA Agent System Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_NAME=qa_agent_db
DB_USER=qa_agent_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Or provide a direct connection string (PostgreSQL or SQLite)
# PostgreSQL: postgresql://qa_agent_user:password@localhost:5432/qa_agent_db
# SQLite: sqlite:///./dev.db
# DATABASE_URL=postgresql://qa_agent_user:your_secure_password_here@localhost:5432/qa_agent_db

# Security & Authentication
# If set, clients must send the header 'X-API-Key: your_secret_api_key_here'
# (The /health and / endpoints remain public for uptime monitors)
API_KEY=your_secret_api_key_here

# CORS Configuration (comma-separated origins or * for all)
CORS_ORIGINS=*

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Redis Cache (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional Custom Model Paths
# TEACHING_QUALITY_MODEL_PATH=/path/to/model.pt
